name: llm_train
conda_env: conda.yml

entry_points:
  main:
    parameters:
      train_data:
        description: Fully-qualified name for the training data artifact
        type: str
      model_name:
        description: HuggingFace model name to fine-tune
        type: str
        default: distilbert-base-uncased
      export_artifact:
        description: Name for the artifact of the exported model. Use "null" for no export.
        type: str
        default: null
      random_seed:
        description: Seed for the random number generator.
        type: int
        default: 42
      val_size:
        description: Size for the validation set as a fraction of the training set
        type: number
        default: 0.1
      stratify:
        description: Column name used for stratification. Use 'null' for no stratification
        type: str
        default: genre
      epochs:
        description: Number of training epochs
        type: int
        default: 1
      batch_size:
        description: Batch size for training
        type: int
        default: 8
    command: >-
      python run.py --train_data {train_data} \
                    --model_name {model_name} \
                    --export_artifact {export_artifact} \
                    --random_seed {random_seed} \
                    --val_size {val_size} \
                    --stratify {stratify} \
                    --epochs {epochs} \
                    --batch_size {batch_size}
